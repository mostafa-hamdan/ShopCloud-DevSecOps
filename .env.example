# Copy to .env and `docker compose --env-file ../.env up`
# These are dev defaults — never use in production.

# Internal service-to-service auth. Catalog/cart/checkout require this
# header on internal endpoints.
INTERNAL_API_KEY=dev-internal-key-change-me

# JWT signing secret in dev (HS256). In prod, set JWT_VERIFIER=cognito
# and use COGNITO_JWKS_URL + COGNITO_AUDIENCE instead.
JWT_SECRET=dev-secret-change-me-please-32bytes-minimum

# Bootstrap admin login (only used by the auth service on first startup).
BOOTSTRAP_ADMIN_EMAIL=admin@shopcloud.example
BOOTSTRAP_ADMIN_PASSWORD=admin12345
