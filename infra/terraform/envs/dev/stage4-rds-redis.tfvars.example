# Turn on VPN before Terraform commands.
# Stage 4 adds managed PostgreSQL and Redis for the dev environment.
# It intentionally keeps Multi-AZ disabled to control cost.
# It does not create NAT Gateway, Client VPN, CloudFront, WAF, Route 53, SQS, Lambda, S3, or Cognito.

aws_region  = "us-east-1"
aws_profile = "shopcloud-new"

enable_networking = true
enable_eks        = true
enable_rds        = true
enable_redis      = true

enable_ecr        = false
enable_s3         = false
enable_sqs        = false
enable_lambda     = false
enable_cognito    = false
enable_monitoring = false
enable_edge       = false
enable_client_vpn = false

node_instance_type = "t3.small"
cluster_version    = "1.33"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 3
