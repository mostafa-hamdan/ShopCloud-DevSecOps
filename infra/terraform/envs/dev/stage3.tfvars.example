# Turn on VPN before Terraform commands.
# Stage 3 creates only the first live dev network + EKS cluster.
# It intentionally does not create RDS, ElastiCache, Client VPN, CloudFront, WAF, Route 53, or NAT Gateway.

aws_region  = "us-east-1"
aws_profile = "shopcloud-new"

enable_networking = true
enable_eks        = true

enable_ecr        = false
enable_rds        = false
enable_redis      = false
enable_s3         = false
enable_sqs        = false
enable_lambda     = false
enable_cognito    = false
enable_monitoring = false
enable_edge       = false
enable_client_vpn = false

node_instance_type = "t3.small"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 3
